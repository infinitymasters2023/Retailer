<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Main.master.cs" Inherits="Patner_Retailer_ADO.Main" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title></title>

    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="../assets/vendor/bootstrap/css/bootstrap.min.css">
    <link href="../assets/vendor/fonts/circular-std/style.css" rel="stylesheet">
    <link rel="stylesheet" href="../assets/libs/css/style.css">
    <link rel="stylesheet" href="../assets/vendor/fonts/fontawesome/css/fontawesome-all.css">
    <link rel="stylesheet" type="text/css" href="../assets/vendor/datatables/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" type="text/css" href="../assets/vendor/datatables/css/buttons.bootstrap4.css">
    <link rel="stylesheet" type="text/css" href="../assets/vendor/datatables/css/select.bootstrap4.css">
    <link rel="stylesheet" type="text/css" href="../assets/vendor/datatables/css/fixedHeader.bootstrap4.css">
    <style>
        /* CSS to style the active menu item */


        .nav-left-sidebar .navbar-nav .nav-item.active > .nav-link {
            background-color: rgb(100, 167, 189) !important;
            color: #fff !important;
        }

        .nav-left-sidebar .navbar-nav .nav-item.active  .nav-link i
        {
            color: #fff;
        }
        .nav-left-sidebar .navbar-nav .nav-item.active > .nav-link:hover {
            /* Optional: Style the hover effect even when active */
            background-color: rgb(100, 167, 189) !important;
        }

        .nav-left-sidebar .navbar-nav .nav-item.active .nav-link svg {
            fill: #fff !important;
        }

        /* You might also want to style the default hover state */
        .nav-left-sidebar .navbar-nav .nav-item .nav-link:hover {
            background-color: #f0f0f0; /* Example default hover background color */
            color: #000; /* Example default hover text color */
        }
        
        .dropdown-menu {
            min-width: 12rem;
            right: 18px;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body>

    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
        <div class="dashboard-main-wrapper">
            <!-- Navbar -->
            <div class="dashboard-header">
                <nav class="navbar navbar-expand-lg bg-white fixed-top">
                    <a class="navbar-brand" href="https://www.infyshield.com/" target="_blank">
                        <img src="assets/images/logo.png" alt="InfyShield" />
                    </a>

                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ml-auto navbar-right-top">
                           <%-- <li class="nav-item">
                                <div id="custom-search" class="top-search-bar">
                                    <input class="form-control" type="text" maxlength="20" placeholder="Search..">
                                </div>
                            </li>--%>

                            <!-- Cart -->
                            <li class="nav-item dropdown cart">
                              <a class="nav-link nav-icons" href="#" id="navbarDropdownCart" data-toggle="dropdown"  <% = GetCartLinkAttributes() %>>
                                    <i class="fas fa-shopping-cart"></i>
                                    <%--<span class="indicator"></span>--%>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-right cart-dropdown">
                                    <li>
                                        <div class="notification-title">Cart Items</div>
                                        <div class="notification-list">
                                            <div class="list-group">
                                                <asp:Repeater ID="rptNotifications" runat="server">
                                                    <ItemTemplate>
                                                        <a href="#" class="list-group-item list-group-item-action">
                                                            <div class="notification-info d-flex align-items-center">
                                                                <div class="notification-list-user-block">
                                                                    <span class="notification-list-user-name"><%# Eval("ProductName") %></span>
                                                                    <div class="notification-date">
                                                                        Qty: <%# Eval("Quantity") %> | Price: ₹<%# Eval("PlanPrice") %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </a>
                                                    </ItemTemplate>
                                                </asp:Repeater>
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="list-footer"><a href="cart.aspx">Go to Cart</a></div>
                                    </li>
                                </ul>
                            </li>


                            <!-- User Info & DateTime -->
                            <li class="nav-item d-flex align-items-center text-dark px-2" style="font-size: 14px;">
                                <div>
                                    <strong><%= Session["Name"] %></strong><br />
                                    <small><%= Session["Role"] %></small><br />
                                    <span id="currentDateTime"></span>
                                </div>
                            </li>


                            <!-- User Profile -->
                            <li class="nav-item dropdown nav-user">
                                <a class="nav-link nav-user-img" href="#" id="navbarDropdownMenuLink2" data-toggle="dropdown">
                                    <img src="../assets/images/avatar5.png" alt="" class="user-avatar-md rounded-circle">
                                </a>
                                <div class="dropdown-menu dropdown-menu-right nav-user-dropdown">
                                    <div class="nav-user-info">
                                        <h5 class="mb-0 text-white nav-user-name"><%= Session["Name"] %></h5>
                                       <%-- <span class="status"></span><span class="ml-2">Available</span>--%>
                                    </div>
                                    <a class="dropdown-item" href="Profile.aspx"><i class="fas fa-user mr-2"></i>Account</a>
                                    <a class="dropdown-item" href="Login.aspx"><i class="fas fa-power-off mr-2"></i>Logout</a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>

            <!-- Sidebar -->
            <div class="nav-left-sidebar sidebar-dark">
                <div class="menu-list">
                    <nav class="navbar navbar-expand-lg navbar-light">
                        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="navbarNav">
                            <ul class="navbar-nav flex-column">
                                <%--<li class="nav-divider">Menu</li>--%>
                                <li id="menuDashboard" runat="server" class="nav-item">
                                    <a class="nav-link" href="Dashboard.aspx"><i class="fas fa-tachometer-alt">&nbsp;</i> Dashboard</a>
                                </li>
                                <li id="menuBuyPlan" runat="server" class="nav-item">
                                    <a class="nav-link" href="BuyInfySalePlan.aspx">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 616 512">
                                            <path d="M602 118.6L537.1 15C531.3 5.7 521 0 510 0H106C95 0 84.7 5.7 78.9 15L14 118.6c-33.5 53.5-3.8 127.9 58.8 136.4 4.5 .6 9.1 .9 13.7 .9 29.6 0 55.8-13 73.8-33.1 18 20.1 44.3 33.1 73.8 33.1 29.6 0 55.8-13 73.8-33.1 18 20.1 44.3 33.1 73.8 33.1 29.6 0 55.8-13 73.8-33.1 18.1 20.1 44.3 33.1 73.8 33.1 4.7 0 9.2-.3 13.7-.9 62.8-8.4 92.6-82.8 59-136.4zM529.5 288c-10 0-19.9-1.5-29.5-3.8V384H116v-99.8c-9.6 2.2-19.5 3.8-29.5 3.8-6 0-12.1-.4-18-1.2-5.6-.8-11.1-2.1-16.4-3.6V480c0 17.7 14.3 32 32 32h448c17.7 0 32-14.3 32-32V283.2c-5.4 1.6-10.8 2.9-16.4 3.6-6.1 .8-12.1 1.2-18.2 1.2z"/>
                                        </svg> Buy InfyShield Plans
                                    </a>
                                </li>
                                <li id="menuSalesPerson" runat="server" class="nav-item">
                                    <a class="nav-link" href="ViewSalesPerson.aspx"><i class="fas fa-users">&nbsp;</i> Sales Person</a>
                                </li>
                                <li id="menuClaims" runat="server" class="nav-item">
                                    <a class="nav-link" href="ReportedClaims.aspx"><i class="fas fa-file-alt">&nbsp;</i> Claims</a>
                                </li>
                                <li id="menuReports" runat="server" class="nav-item">
                                    <a class="nav-link" href="Reports.aspx"><i class="fas fa-fw fa-chart-pie">&nbsp;</i> Reports</a>
                                </li>
                                <li id="menuSalesReport" runat="server" class="nav-item">
                                    <a class="nav-link" href="SalesReports.aspx"><i class="fas fa-chart-area">&nbsp;</i> Sales Reports</a>
                                </li>
                                <%--<li id="menuClaimList" runat="server" class="nav-item">
                                    <a class="nav-link" href="ClaimList.aspx"><i class="fas fa-fw fa-table"></i>Claim List</a>
                                </li>--%>
                            </ul>
                        </div>
                    </nav>
                </div>
            </div>

            <!-- Main Content -->
            <div class="dashboard-wrapper">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <!-- JS Scripts -->
    <script src="../assets/vendor/jquery/jquery-3.3.1.min.js"></script>
    <script src="../assets/vendor/bootstrap/js/bootstrap.bundle.js"></script>
    <script src="../assets/vendor/slimscroll/jquery.slimscroll.js"></script>
    <script src="../assets/vendor/multi-select/js/jquery.multi-select.js"></script>
    <script src="../assets/libs/js/main-js.js"></script>
    <script src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>
    <script src="../assets/vendor/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.5.2/js/dataTables.buttons.min.js"></script>
    <script src="../assets/vendor/datatables/js/buttons.bootstrap4.min.js"></script>
    <script src="../assets/vendor/datatables/js/data-table.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.5.2/js/buttons.html5.min.js"></script>

</body>
</html>
