<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Main.master.cs" Inherits="Patner_Retailer_ADO.Main" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Retailer</title>
    <link rel="icon" type="image/png" href="../assets/images/Infyshield-logo.png" />

    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="../assets/vendor/bootstrap/css/bootstrap.min.css">
    <link href="../assets/vendor/fonts/circular-std/style.css" rel="stylesheet">
    <link rel="stylesheet" href="../assets/libs/css/style.css">
    <link rel="stylesheet" href="../assets/vendor/fonts/fontawesome/css/fontawesome-all.css">
    <link rel="stylesheet" type="text/css" href="../assets/vendor/datatables/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" type="text/css" href="../assets/vendor/datatables/css/buttons.bootstrap4.css">
    <link rel="stylesheet" type="text/css" href="../assets/vendor/datatables/css/select.bootstrap4.css">
    <link rel="stylesheet" type="text/css" href="../assets/vendor/datatables/css/fixedHeader.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.bootstrap4.min.css" />

    <!-- Slick CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />





    <style>
        /* CSS to style the active menu item */
        .disabled-link {
            pointer-events: none;
            color: gray !important;
            cursor: default;
            opacity: 0.6;
        }

        .prev-step, .next-step {
            font-size: 12px;
            padding: 9px 15px;
            border: none;
            border-radius: 5px;
            margin-top: 28px;
            color: #fff;
        }

        .next-step {
            background: linear-gradient(90deg, rgba(78, 49, 170, 1) 0%, rgba(122, 28, 172, 1) 100%);
        }

        .prev-step:hover {
            font-size: 12px;
            padding: 9px 15px;
            border: none;
            border-radius: 5px;
            margin-top: 28px;
            color: #fff;
        }

        .foot-infinity-details h4 {
            font-size: 16px;
            font-weight: 600;
        }

        .nav-left-sidebar .navbar-nav .nav-item.active > .nav-link {
            background-color: rgb(100, 167, 189) !important;
            color: #fff !important;
        }

        .nav-left-sidebar .navbar-nav .nav-item.active .nav-link i {
            color: #fff;
        }

        .nav-left-sidebar .navbar-nav .nav-item.active > .nav-link:hover {
            /* Optional: Style the hover effect even when active */
            background-color: rgb(100, 167, 189) !important;
        }

        /*.nav-left-sidebar .navbar-nav .nav-item.active .nav-link svg {
            fill: #fff !important;
        }*/

        .nav-left-sidebar .navbar-nav .nav-item .nav-link:hover {
            background-color: rgb(100, 167, 189);
            color: #fff;
        }

        .dropdown-menu {
            min-width: 12rem;
            right: -90px;
        }

        li.nav-item.dropdown.cart {
            display: flex;
            align-items: center;
        }

            li.nav-item.dropdown.cart a {
                border: 1px solid #e7e7e7;
                padding: 7px !important;
                border-radius: 5px;
                font-size: 12px;
                margin-right: 10px;
                display: flex;
                align-items: center;
            }

                li.nav-item.dropdown.cart a i {
                    color: #0d6efd;
                    padding-right: 5px;
                }

                li.nav-item.dropdown.cart a svg {
                    color: #0d6efd;
                    padding-right: 5px;
                    height: 14px;
                }

        .role-txt {
            font-size: 12px;
            text-align: center;
            display: block;
            font-weight: 400;
        }

        .free-name-txt {
            font-size: 14px;
            font-weight: 600;
            letter-spacing: .5px;
            line-height: 18px;
        }

        .expend-menu-icon {
            position: relative;
            left: 75px;
            cursor: pointer;
        }
        /* For sidebar toggle */
        .sidebar-collapsed .nav-left-sidebar {
            width: 56px;
            overflow: hidden;
            transition: all 0.3s ease;
            min-width: 56px;
        }

        .sidebar-collapsed .dashboard-wrapper {
            margin-left: 70px !important;
            width: 95.5%;
            transition: all 0.3s ease;
        }

        /* Default full sidebar */
        .nav-left-sidebar {
            width: 245px;
            transition: all 0.3s ease;
        }

        .dashboard-wrapper {
            margin-left: 264px;
            transition: all 0.3s ease;
        }
        /* Hide text on collapsed menu */
        .sidebar-collapsed .nav-left-sidebar .navbar-nav .nav-link span {
            display: none;
        }

        /* Align icon center when sidebar is collapsed */
        .sidebar-collapsed .nav-left-sidebar .navbar-nav .nav-item .nav-link {
            text-align: center;
        }

        /* Icons always visible */
        .nav-left-sidebar .navbar-nav .nav-item .nav-link i,
        .nav-left-sidebar .navbar-nav .nav-item .nav-link svg {
            vertical-align: middle;
        }

        /* Reduce svg margin when collapsed */
        .sidebar-collapsed .nav-left-sidebar .navbar-nav .nav-item .nav-link svg,
        .sidebar-collapsed .nav-left-sidebar .navbar-nav .nav-item .nav-link i {
            margin-right: 0;
        }

        /* Animate transition */
        .nav-left-sidebar, .dashboard-wrapper {
            transition: all 0.3s ease;
        }

        .passbook-txt a {
            font-size: 12px;
            border: 1px solid #e7e7e7;
            border-radius: 5px;
            margin-right: 10px;
            padding: 7px !important;
            display: flex;
            gap: 5px;
            align-items: center;
        }

        @media (max-width: 991px) {
            .nav-left-sidebar {
                position: fixed;
                left: -260px;
                top: 0;
                height: 100%;
                z-index: 999;
                background: #fff;
            }

                .nav-left-sidebar.active {
                    left: 0;
                    top: 60px;
                }

            .dashboard-wrapper {
                /* margin-left: 0 !important; */
                width: auto;
                margin: 15px;
            }

            .navbar-brand img {
                /* max-width: 100%; */
                max-width: 120px;
                height: auto;
            }

            .navbar-brand {
                margin-right: 0rem;
                padding: 0px;
            }

            .collapse:not(.show) {
                display: block !important;
            }

            .dashboard-header .navbar-collapse {
                flex-basis: inherit;
                margin-left: 15px;
            }

            .navbar-right-top {
                flex-direction: row;
                /*justify-content: space-between;*/
            }

            .dashboard-header .navbar {
                padding: 0px;
                border-bottom: 1px solid #e6e6f2;
                -webkit-transition: all 0.3s ease;
                min-height: 60px;
                justify-content: start;
                flex-wrap: nowrap;
                gap: 15px;
            }

            .free-name-txt {
                display: none;
            }

            .dashboard-header .navbar-nav .dropdown-menu {
                position: absolute;
                float: none;
                right: 0px;
            }

            .dashboard-header .navbar .navbar-toggler {
                padding: 0rem;
            }

            .expend-menu-icon {
                display: none;
            }

            .dashboard-header .navbar .navbar-collapse .navbar-nav {
                flex-direction: row;
                justify-content: start;
            }
            .footer-mar-sty{
                margin-left:0px !important;               
            }
        }

        @media (min-width:992px) {
            .navbar-expand-lg .navbar-nav .dropdown-menu {
                right: 0;
            }
        }

        html, body, #form1 {
            height: 100%;
        }

        .dashboard-main-wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100%;
        }

        .dashboard-wrapper {
            flex-grow: 1;
        }

        .dropdown-menu {
            min-width: 12rem;
        }

        .foot-infinity-details p {
            font-size: 14px;
        }
        .footer-mar-sty{
            margin-left:240px;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <script src="https://unpkg.com/feather-icons"></script>
</head>

<body>

    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePartialRendering="true" />

        <div class="dashboard-main-wrapper">
            <!-- Navbar -->

            <div class="dashboard-header">
                <nav class="navbar navbar-expand-lg bg-white fixed-top d-flex justify-content-between align-items-center px-3">

                    <!-- Left: Logo + Menu Toggler -->
                    <div class="d-flex align-items-center">
                        <a class="navbar-brand mr-3" href="https://www.infyshield.com/" target="_blank">
                            <img src="assets/images/logo.png" alt="InfyShield" height="40" />
                        </a>

                        <!-- Menu Toggle Icon (Mobile) -->
                        <button class="navbar-toggler border-0" type="button" data-toggle="collapse" data-target="#navbarSupportedContent">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <rect y="4" width="20" height="2" fill="currentColor" />
                                <rect y="11" width="20" height="2" fill="currentColor" />
                                <rect y="18" width="20" height="2" fill="currentColor" />
                            </svg>
                        </button>

                        <div class="expend-menu-icon">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect y="4" width="20" height="2" fill="currentColor" />
                                <rect y="11" width="20" height="2" fill="currentColor" />
                                <rect y="18" width="20" height="2" fill="currentColor" />
                            </svg>
                        </div>

                    </div>

                    <!-- Right: Navbar Content -->
                    <div class="collapse navbar-collapse justify-content-end" id="navbarSupportedContent">

                        <ul class="navbar-nav mx-auto d-none d-lg-block">
                            <!-- Center content -->
                            <li class="nav-item d-flex align-items-center">
                                <asp:Image ID="imgCompanyLogo" runat="server" Width="150" Height="35" CssClass="d-inline-block align-top mr-2" />
                                <asp:Label ID="lbllegalNameHeader" runat="server" CssClass="font-weight-bold"
                                    Style="font-size: 16px; color: #64a7bd"></asp:Label>
                            </li>

                        </ul>
                        <ul class="navbar-nav align-items-center">
                            <!-- Passbook -->
                            <li class="nav-item passbook-txt">
                                <a class="nav-link nav-icons px-2" href="Passbook.aspx">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="14" height="14">
                                        <path fill="#000082" d="M64 32C28.7 32 0 60.7 0 96L0 416c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-224c0-35.3-28.7-64-64-64L80 128c-8.8 0-16-7.2-16-16s7.2-16 16-16l368 0c17.7 0 32-14.3 32-32s-14.3-32-32-32L64 32zM416 272a32 32 0 1 1 0 64 32 32 0 1 1 0-64z" />
                                    </svg>
                                    <span class="d-none d-lg-inline ml-1">Passbook</span>
                                </a>
                            </li>

                            <!-- Cart -->

                            <li class="nav-item dropdown cart" style="position: relative;">
                                <a class="nav-link nav-icons px-2" href="#" id="navbarDropdownCart" data-toggle="dropdown" <%= GetCartLinkAttributes() %>>
                                    <i class="fas fa-shopping-cart"></i>
                                    <span class="d-none d-lg-inline ml-1">Cart</span>

                                    <span class="badge badge-pill badge-danger" style="position: absolute; top: -12px; right: 1px;">
                                        <asp:Label ID="lblCartCount" runat="server" Text="0"></asp:Label>
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-right cart-dropdown">
                                    <li>
                                        <div class="notification-title">Cart Items</div>
                                        <div class="notification-list">
                                            <div class="list-group">
                                                <asp:Repeater ID="rptNotifications" runat="server">
                                                    <ItemTemplate>
                                                        <a href="CartDetails.aspx" class="list-group-item list-group-item-action">
                                                            <div class="notification-info d-flex align-items-center">
                                                                <div class="notification-list-user-block">
                                                                    <span class="notification-list-user-name"><%# Eval("ProductName") %></span>
                                                                    <div class="notification-date">
                                                                        Qty: <%# Eval("Quantity") %> | Price: ₹<%# Eval("PlanPrice") %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </a>
                                                    </ItemTemplate>
                                                </asp:Repeater>
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="list-footer">
                                            <a href="CartDetails.aspx">Go to Cart</a>
                                        </div>
                                    </li>
                                </ul>
                            </li>


                            <!-- User Profile -->
                            <li class="nav-item dropdown nav-user ml-lg-2">
                                <a class="nav-link nav-user-img" href="#" id="navbarDropdownMenuLink2" data-toggle="dropdown">
                                    <div class="d-flex align-items-center">
                                        <%--<img src="../assets/images/avatar5.png" alt="" class="user-avatar-md rounded-circle mr-2" />--%>
                                        <asp:Image ID="profileImage" runat="server" CssClass="user-avatar-md rounded-circle mr-2" />
                                        <div class="d-none d-lg-block text-dark">
                                            <div class="free-name-txt">
                                                <%= Session["Name"] %><br />
                                                <span class="role-txt"><%= Session["Role"] %></span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right nav-user-dropdown">
                                    <a class="dropdown-item" href="Profile.aspx"><i class="fas fa-user mr-2"></i>Profile</a>
                                    <a class="dropdown-item" href="Index.aspx"><i class="fas fa-power-off mr-2"></i>Logout</a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>

            <!-- Sidebar -->
            <div class="nav-left-sidebar sidebar-dark">
                <div class="menu-list">
                    <nav class="navbar navbar-expand-lg navbar-light">
                        <%-- <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
                            <span class="navbar-toggler-icon"></span>
                        </button>--%>
                        <div class="collapse navbar-collapse" id="navbarNav" style="overflow: auto;">
                            <ul class="navbar-nav flex-column">
                                <%--<li class="nav-divider">Menu</li>--%>
                                <li id="menuDashboard" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkDashboard" runat="server" href="Dashboard.aspx"><i data-feather="layout"></i>
                                        <span class="menu-text">Dashboard</span>
                                    </a>
                                </li>
                                <li id="menuIncentive_Dashboard" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkIncentive_Dashboard" runat="server" href="Incentive_Dashboard.aspx"><i data-feather="layout"></i>
                                        <span class="menu-text">Incentive Dashboard</span>
                                    </a>
                                </li>
                                <li id="menuBuyPlan" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkBuyPlan" runat="server" href="ProductInformation.aspx">
                                        <i data-feather="shopping-cart"></i>
                                        <span class="menu-text">Sell InfyShield Plans</span>
                                    </a>
                                </li>
                                <li id="menuSalesPerson" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkSalesPerson" runat="server" href="ViewSalesPerson.aspx"><i data-feather="user"></i>
                                        <span class="menu-text">Sales Executive</span>
                                    </a>
                                </li>
                                <li id="menuIncomplete" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkIncomplete" runat="server" href="InCompletePurchased.aspx">
                                        <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg">
                                            <path fill="none" d="M0 0h24v24H0V0z"></path>
                                            <path d="M16.24 7.75A5.974 5.974 0 0 0 12 5.99v6l-4.24 4.24c2.34 2.34 6.14 2.34 8.49 0a5.99 5.99 0 0 0-.01-8.48zM12 1.99c-5.52 0-10 4.48-10 10s4.48 10 10 10 10-4.48 10-10-4.48-10-10-10zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"></path>
                                        </svg>
                                        <span class="menu-text">Incomplete Purchased</span>
                                    </a>
                                </li>
                                <li id="menuRequestFromSalesPerson" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkRequestFromSalesPerson" runat="server" href="RequestfromSalesperson.aspx">
                                        <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg">
                                            <path fill="none" d="M0 0h24v24H0V0z"></path>
                                            <path d="M16.24 7.75A5.974 5.974 0 0 0 12 5.99v6l-4.24 4.24c2.34 2.34 6.14 2.34 8.49 0a5.99 5.99 0 0 0-.01-8.48zM12 1.99c-5.52 0-10 4.48-10 10s4.48 10 10 10 10-4.48 10-10-4.48-10-10-10zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"></path>
                                        </svg>
                                        <span class="menu-text">Request from Sales Executive</span>
                                    </a>
                                </li>
                                <li id="menuSalesReport" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkSalesReport" runat="server" href="SalesReports.aspx"><i data-feather="bar-chart"></i>
                                        <span class="menu-text">Sales Reports</span>
                                    </a>
                                </li>
                                <li id="menuClaims" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkClaims" runat="server" href="ReportedClaims.aspx"><i data-feather="file-text"></i>
                                        <span class="menu-text">Registration/Claim</span>
                                    </a>
                                </li>
                                <li id="menuCommisionDetails" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkCommisionDetails" runat="server" href="CommissionDetails.aspx"><i data-feather="file-text"></i>
                                        <span class="menu-text">Commission Details</span>
                                    </a>
                                </li>
                                <li id="menuProductPriceBand" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkProductPriceBand" runat="server" href="ProductPriceBand.aspx"><i data-feather="file-text"></i>
                                        <span class="menu-text">Product Price Band</span>
                                    </a>
                                </li>
                                <%--  <li id="menuReports" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkReports" runat="server" href="Reports.aspx"><i data-feather="pie-chart"></i>Reports</a>
                                </li>
                               <li id="menuSalesPersonSalesReport" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkSalesPersonSalesReport" runat="server" href="SalesPersonSalesReport.aspx"><i data-feather="pie-chart"></i>Sales Person Wise Reports</a>
                                </li>--%>
                                <li id="menuGenerateURL" runat="server" class="nav-item" visible="false">
                                    <a class="nav-link" id="linkGenerateURL" runat="server" href="RetailerAddURL.aspx"><i data-feather="link"></i>
                                        <span class="menu-text">Generate URL</span>
                                    </a>
                                </li>
                                <li id="menuFAQ" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkFAQ" runat="server" href="FAQ.aspx"><i data-feather="help-circle"></i>
                                        <span class="menu-text">FAQ's</span>
                                    </a>
                                </li>
                                <li id="menuUpgradePlan" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkUpgradePlan" runat="server" href="UpgradePlan.aspx"><i data-feather="arrow-up-circle"></i>
                                        <span class="menu-text">Upgrade Plan</span>
                                    </a>
                                </li>
                                <li id="menuMyOffer" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkMyOffer" runat="server" href="MyOffer.aspx"><i data-feather="tag"></i>
                                        <span class="menu-text">My Offers</span>
                                    </a>
                                </li>
                                <li id="menuHowItWorks" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkHowItWorks" runat="server" href="HowItWorks.aspx"><i data-feather="activity"></i>
                                        <span class="menu-text">How It Works</span>
                                    </a>
                                </li>
                                <li id="menuReferFriend" runat="server" class="nav-item" visible="false">
                                    <a class="nav-link" id="linkReferFriend" runat="server" href="ReferFriend.aspx"><i data-feather="share-2"></i>
                                        <span class="menu-text">Refer a Friend</span>
                                    </a>
                                </li>
                                <li id="menuReachUs" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkReachUs" runat="server" href="ReachUs.aspx"><i data-feather="headphones"></i>
                                        <span class="menu-text">Reach Us</span>
                                    </a>
                                </li>
                                <li id="menuFeedback" runat="server" class="nav-item">
                                    <a class="nav-link" id="linkFeedback" runat="server" href="Feedback.aspx">
